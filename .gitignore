# ============================================================================
# DOCUMENTATION (but keep in git)
# ============================================================================

# Obsidian vault is symlinked, not copied
# docs/ is a symlink — tracked, but target is external

# Generated docs (if we auto-generate API docs)
docs/api/
docs/_build/
docs/.doctrees/

# ============================================================================
# SPECIAL CASES
# ============================================================================

# Allow specific files that would otherwise be ignored
!.gitignore
!.gitkeep
!README.md
!CLAUDE.md
!AGENTS.md

# Example/template files
!.env.example
!config.example.yaml
!secrets.example.yaml

# Schema definitions (these are code, not data)
!schemas/*.json
!config/schemas/*.json

# Test fixtures (mock data for testing)
!tests/fixtures/*.json
!tests/mocks/*.json

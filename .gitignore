# The Foundry - Comprehensive Git Ignore

# ============================================================================
# RUNTIME DATA (Never commit — regenerated nightly)
# ============================================================================

# Agent outputs (nightly pipeline data)
workspace/
*.json
!config/**/*.json
!tests/**/*.json
!src/**/*.json

# Build artifacts
out/
output/
artifacts/
builds/
*.build
*.artifact

# Logs
*.log
*.log.*
logs/
*.tmp
*.temp

# State files
state.json
*.state

# Cache
.cache/
*.cache
__pycache__/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ============================================================================
# SECRETS & CREDENTIALS (Never commit — security critical)
# ============================================================================

# Environment variables
.env
.env.*
!.env.example
.envrc

# API keys and tokens
*.key
*.pem
*.p12
*.pfx
secrets/
*.secret
api-keys.yaml
credentials.yaml

# OpenClaw specific
config/secrets.yaml
config/local.yaml
config/credentials.json

# 1Password CLI cache (if used)
.op/

# SSH keys
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub
*.ppk

# GPG keys
*.gpg
*.asc
secring.*


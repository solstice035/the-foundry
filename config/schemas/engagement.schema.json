{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://foundry.jeevesbot.io/schemas/engagement.v1.json",
  "title": "GitHub Engagement Summary",
  "description": "Daily engagement metrics for all public Foundry repos",
  "type": "object",
  "required": [
    "schema_version",
    "date",
    "repos",
    "summary"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "Date of engagement check (YYYY-MM-DD)"
    },
    "checked_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp when check was performed"
    },
    "repos": {
      "type": "array",
      "description": "Engagement data for each repository",
      "items": {
        "type": "object",
        "required": ["name", "url", "stats"],
        "properties": {
          "name": {
            "type": "string",
            "description": "Repository name (e.g., foundry-20260218-pdf-privacy-tools)"
          },
          "full_name": {
            "type": "string",
            "description": "Full repository name (e.g., jeevesbot-io/foundry-20260218-pdf-privacy-tools)"
          },
          "url": {
            "type": "string",
            "format": "uri",
            "description": "GitHub repository URL"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "description": "Repository creation date"
          },
          "age_days": {
            "type": "integer",
            "minimum": 0,
            "description": "Age of repository in days"
          },
          "stats": {
            "type": "object",
            "required": ["stars", "forks", "issues", "watchers"],
            "properties": {
              "stars": {
                "type": "integer",
                "minimum": 0
              },
              "forks": {
                "type": "integer",
                "minimum": 0
              },
              "issues": {
                "type": "integer",
                "minimum": 0,
                "description": "Total open issues"
              },
              "watchers": {
                "type": "integer",
                "minimum": 0
              },
              "external_issues": {
                "type": "integer",
                "minimum": 0,
                "description": "Issues opened by external contributors"
              }
            }
          },
          "growth": {
            "type": "object",
            "description": "Change since previous day",
            "properties": {
              "stars_delta": {
                "type": "integer",
                "description": "Change in stars"
              },
              "forks_delta": {
                "type": "integer",
                "description": "Change in forks"
              },
              "issues_delta": {
                "type": "integer",
                "description": "Change in issues"
              }
            }
          },
          "thresholds": {
            "type": "object",
            "description": "Threshold status for this repo",
            "properties": {
              "crossed_25_stars": {
                "type": "boolean",
                "description": "Repo has 25+ stars"
              },
              "crossed_50_stars": {
                "type": "boolean",
                "description": "Repo has 50+ stars"
              },
              "has_external_issues": {
                "type": "boolean",
                "description": "Repo has 2+ external issues"
              },
              "eligible_for_consensus": {
                "type": "boolean",
                "description": "Meets criteria for Consensus Analyst (25+ stars + 3 days old)"
              }
            }
          },
          "notable_issues": {
            "type": "array",
            "description": "High-priority issues or mentions",
            "items": {
              "type": "object",
              "properties": {
                "number": {"type": "integer"},
                "title": {"type": "string"},
                "author": {"type": "string"},
                "url": {"type": "string"},
                "created_at": {"type": "string"},
                "is_external": {"type": "boolean"}
              }
            }
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "description": "Overall engagement summary",
      "required": ["total_repos", "total_stars", "total_forks", "total_issues"],
      "properties": {
        "total_repos": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of repositories checked"
        },
        "total_stars": {
          "type": "integer",
          "minimum": 0
        },
        "total_forks": {
          "type": "integer",
          "minimum": 0
        },
        "total_issues": {
          "type": "integer",
          "minimum": 0
        },
        "high_engagement_repos": {
          "type": "array",
          "description": "Repos with notable engagement (25+ stars or 2+ external issues)",
          "items": {
            "type": "string",
            "description": "Repository name"
          }
        },
        "repos_needing_consensus": {
          "type": "array",
          "description": "Repos eligible for Consensus Analyst review",
          "items": {
            "type": "string",
            "description": "Repository name"
          }
        },
        "action_items": {
          "type": "array",
          "description": "Recommended actions based on engagement",
          "items": {
            "type": "object",
            "properties": {
              "repo": {"type": "string"},
              "action": {"type": "string"},
              "priority": {
                "type": "string",
                "enum": ["high", "medium", "low"]
              },
              "reason": {"type": "string"}
            }
          }
        }
      }
    }
  }
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://jeevesbot.io/schemas/foundry/voice-patterns.json",
  "title": "Voice Patterns Schema",
  "description": "Learned voice patterns from Nick's content approvals and edits",
  "type": "object",
  "required": ["schema_version", "last_updated", "patterns"],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1,
      "description": "Schema version for compatibility"
    },
    "last_updated": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of last update"
    },
    "source": {
      "type": "string",
      "description": "How these patterns were derived (manual_seeding, voice_learning, etc.)"
    },
    "patterns": {
      "$ref": "#/definitions/voicePatterns"
    },
    "nick_corrections": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Specific corrections Nick has made to drafts",
      "default": []
    },
    "engagement_learnings": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Engagement-based learnings about voice",
      "default": []
    }
  },
  "definitions": {
    "voicePatterns": {
      "type": "object",
      "properties": {
        "preferred_phrases": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Phrases and phrasings Nick prefers"
        },
        "banned_phrases": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Phrases to never use"
        },
        "style_rules": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Stylistic rules for content"
        },
        "content_type_preferences": {
          "type": "object",
          "description": "Per-content-type preferences",
          "additionalProperties": {
            "$ref": "#/definitions/contentTypePreference"
          }
        }
      }
    },
    "contentTypePreference": {
      "type": "object",
      "properties": {
        "max_tweets": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10,
          "description": "Maximum tweets in a thread for this content type"
        },
        "include_cost": {
          "type": "boolean",
          "description": "Whether to include build cost"
        },
        "include_build_time": {
          "type": "boolean",
          "description": "Whether to include build time"
        },
        "tone": {
          "type": "string",
          "description": "Tone for this content type"
        },
        "include_pipeline_stats": {
          "type": "boolean",
          "description": "Whether to include pipeline statistics"
        },
        "require_specific_data": {
          "type": "boolean",
          "description": "Whether specific data is required"
        },
        "show_disagreement": {
          "type": "boolean",
          "description": "Whether to highlight disagreement between perspectives"
        }
      }
    }
  }
}

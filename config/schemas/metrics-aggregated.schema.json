{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://foundry.jeevesbot.io/schemas/metrics-aggregated.v1.json",
  "title": "Weekly Metrics Summary",
  "description": "Aggregated metrics for portfolio reporting",
  "type": "object",
  "required": ["week_start", "week_end", "nights_total", "overview", "performance", "sources", "categories"],
  "properties": {
    "week_start": {
      "type": "string",
      "format": "date",
      "description": "Week start date (Monday)"
    },
    "week_end": {
      "type": "string",
      "format": "date",
      "description": "Week end date (Sunday)"
    },
    "nights_total": {
      "type": "integer",
      "minimum": 0,
      "description": "Number of nights in this week"
    },
    "overview": {
      "type": "object",
      "required": ["builds_attempted", "builds_succeeded", "builds_failed", "specs_rejected", "success_rate"],
      "properties": {
        "builds_attempted": {
          "type": "integer",
          "minimum": 0,
          "description": "Total nights with spec approval"
        },
        "builds_succeeded": {
          "type": "integer",
          "minimum": 0,
          "description": "Successful builds"
        },
        "builds_failed": {
          "type": "integer",
          "minimum": 0,
          "description": "Failed or partial builds"
        },
        "specs_rejected": {
          "type": "integer",
          "minimum": 0,
          "description": "Nights with no buildable trends"
        },
        "success_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "Percentage of successful builds (of attempts)"
        },
        "approval_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "Percentage of nights with approved specs"
        }
      }
    },
    "performance": {
      "type": "object",
      "required": ["avg_scan_time_s", "avg_spec_time_s", "avg_build_time_s", "avg_total_time_s", "total_cost_usd", "avg_cost_per_night"],
      "properties": {
        "avg_scan_time_s": {
          "type": "number",
          "minimum": 0
        },
        "avg_spec_time_s": {
          "type": "number",
          "minimum": 0
        },
        "avg_build_time_s": {
          "type": "number",
          "minimum": 0
        },
        "avg_total_time_s": {
          "type": "number",
          "minimum": 0
        },
        "total_cost_usd": {
          "type": "number",
          "minimum": 0
        },
        "avg_cost_per_night": {
          "type": "number",
          "minimum": 0
        },
        "total_tokens": {
          "type": ["integer", "null"],
          "minimum": 0
        }
      }
    },
    "sources": {
      "type": "object",
      "required": ["effectiveness"],
      "properties": {
        "effectiveness": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["source", "trends_found", "builds_shipped", "success_rate"],
            "properties": {
              "source": {
                "type": "string",
                "description": "Source name (hn, reddit, x, etc.)"
              },
              "trends_found": {
                "type": "integer",
                "minimum": 0,
                "description": "Total trends from this source"
              },
              "builds_shipped": {
                "type": "integer",
                "minimum": 0,
                "description": "Builds from this source's trends"
              },
              "success_rate": {
                "type": "number",
                "minimum": 0,
                "maximum": 100,
                "description": "Percentage of trends from this source that became builds"
              },
              "avg_engagement": {
                "type": ["number", "null"],
                "minimum": 0,
                "maximum": 100
              }
            }
          }
        },
        "failures": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "source": {
                "type": "string"
              },
              "failure_count": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "categories": {
      "type": "object",
      "required": ["distribution"],
      "properties": {
        "distribution": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["category", "count", "percentage"],
            "properties": {
              "category": {
                "type": "string"
              },
              "count": {
                "type": "integer",
                "minimum": 0
              },
              "percentage": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              "avg_buildability": {
                "type": ["number", "null"],
                "minimum": 0,
                "maximum": 10
              }
            }
          }
        }
      }
    },
    "rejection_reasons": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["reason", "count"],
        "properties": {
          "reason": {
            "type": "string"
          },
          "count": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "recommendations": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Actionable insights for improvement"
    },
    "notable_builds": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "project": {
            "type": "string"
          },
          "repo_url": {
            "type": "string",
            "format": "uri"
          },
          "buildability_score": {
            "type": "number"
          },
          "engagement_score": {
            "type": "number"
          }
        }
      }
    }
  }
}

# The Foundry - Environment Variables Template
# Copy this to .env and fill in real values

# ============================================================================
# OPENAI / ANTHROPIC (for aider, if not using OpenClaw's keys)
# ============================================================================

# Anthropic API key (for Claude models in aider)
# Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI API key (if using OpenAI models in aider)
# Get from: https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-...

# ============================================================================
# GITHUB (for Builder to create repos)
# ============================================================================

# GitHub Personal Access Token
# Get from: https://github.com/settings/tokens
# Scopes needed: repo (full), workflow (if using GitHub Actions)
GITHUB_TOKEN=ghp_...

# GitHub username (for repo creation)
GITHUB_USERNAME=jeevesbot-io

# ============================================================================
# X/TWITTER (for Trend Scout)
# ============================================================================

# X authentication tokens (extracted from browser)
# See: docs/Deep Dive - Trend Research.md for extraction method
X_AUTH_TOKEN=...
X_CT0=...

# ============================================================================
# REDDIT (for Trend Scout)
# ============================================================================

# Reddit doesn't need auth for JSON endpoints (using public access)
# If rate-limited, can add Reddit API credentials here:
# REDDIT_CLIENT_ID=...
# REDDIT_CLIENT_SECRET=...

# ============================================================================
# HACKER NEWS (for Trend Scout)
# ============================================================================

# Hacker News Algolia API doesn't need auth (public)

# ============================================================================
# PRODUCTHUNT (for Phase 2 - Trend Scout expansion)
# ============================================================================

# ProductHunt API credentials (when Phase 2 starts)
# Get from: https://api.producthunt.com/v2/docs
# PRODUCTHUNT_CLIENT_ID=...
# PRODUCTHUNT_CLIENT_SECRET=...

# ============================================================================
# OPENCLAW (if sub-agents need to spawn further agents)
# ============================================================================

# OpenClaw gateway URL (local)
OPENCLAW_GATEWAY_URL=http://localhost:4445

# OpenClaw API token (if needed for agent-to-agent communication)
# Leave blank if using local session-based auth
# OPENCLAW_TOKEN=...

# ============================================================================
# DEVELOPMENT / TESTING
# ============================================================================

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Dry run mode (don't actually create GitHub repos, don't post to social)
DRY_RUN=false

# Test mode (use mock data instead of real APIs)
TEST_MODE=false

# ============================================================================
# PATHS (usually don't need to change these)
# ============================================================================

# Workspace directory (where agents write runtime data)
FOUNDRY_WORKSPACE=~/.openclaw/workspace/foundry

# Project directory (where this repo lives)
FOUNDRY_PROJECT=~/projects/the-foundry

# Builds directory (where Builder creates projects)
FOUNDRY_BUILDS=~/projects/foundry
